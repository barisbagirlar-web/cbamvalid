# Firebase Client Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin Credentials
ADMIN_SERVICE_ACCOUNT_B64=
ADMIN_USE_ADC=false
ADMIN_ADC_RUNTIME_CONFIRMED=false

# Allowed Origins & Session Controls
AUTH_ALLOWED_ORIGINS=https://cbamvalid.com
AUTH_SESSION_TTL_SECONDS=432000
AUTH_SESSION_MAX_AUTH_AGE_SECONDS=300

# Paddle Billing
# Keep sandbox in local/staging until the live Paddle account and cbamvalid.com
# checkout domain are approved. Sandbox and live have separate credentials,
# products, prices, webhook destinations, and data.
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_SANDBOX=true
PADDLE_API_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID=
PADDLE_WEBHOOK_SECRET=

# Optional explicit overrides. Normally leave blank and let the application derive
# the API base and Cloud Functions webhook URL from the credential/project pair.
PADDLE_API_BASE=
PADDLE_WEBHOOK_FUNCTION_URL=
FIREBASE_PROJECT=
FUNCTIONS_REGION=europe-west1

# Public paid launch is NOT controlled by an environment variable.
# Keep Firestore system/config.publicPaidLaunchEnabled=false until live account,
# domain, catalog, webhook, checkout, refund, and entitlement smoke tests pass.
